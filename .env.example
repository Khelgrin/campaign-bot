# Copy this file to .env and replace the placeholder with your Discord bot token.
# Never commit the .env file.
DISCORD_TOKEN=replace-with-your-discord-bot-token

# Optional: channel ID where the bot sends "Ready to rumble" after it connects.
DISCORD_READY_CHANNEL_ID=replace-with-your-channel-id

# SQLite database path. Keep this on a persistent volume in deployments.
JOURNALBOT_DATABASE_PATH=data/journalbot.sqlite3
